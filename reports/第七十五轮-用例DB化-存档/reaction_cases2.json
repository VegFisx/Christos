  {
    "id": "red_para_anthraquinone",
    "kind": "rule",
    "rule": "reduction_quinone_para_001",
    "smiles": "O=C1c2ccccc2C(=O)c2ccccc21",
    "name": "9,10-蒽醌",
    "conditions": "还原",
    "expect_any": [
      "Oc1c2ccccc2c(O)c2ccccc12"
