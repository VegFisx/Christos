      "reversible": false,
      "co_reagents": {
        "H2O": 1
      },
      "byproducts": {},
      "condition_profile": "hydrolysis",
      "priority": 0.8,
      "status": "active",
      "notes": "实测差值 O1H2，补 1 分子水。皂苷脱糖生成苷元。糖环本身是环，RDChiral 能正确打开糖苷键并保持糖环完整。",
      "max_products_per_molecule": 3
    },
    {
