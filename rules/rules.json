    {
      "id": "hydrolysis_ester_001",
      "name": "酯水解",
      "category": "hydrolysis",
      "smarts": "[C:1](=[O:2])[O:3][#6:4]>>[C:1](=[O:2])[O:3][H].[C:4][OH]",
      "reversible": false,
      "co_reagents": {
        "H2O": 1
      },
      "byproducts": {},
      "condition_profile": "hydrolysis",
      "priority": 0.85,
      "status": "active",
      "notes": "实测差值 O1H2，补 1 分子水即配平。乌头碱减毒主途径。引擎须用 RDChiral：rdkit 原生 RunReactants 在环内断键时会复制原子。 【修复】取代基碳原写成 [C:]（只匹配脂肪碳），导致【酚酯/芳基酰胺】等芳香取代底物匹配不上。已改为 [#6:]（任意碳）。同类问题见糖苷水解。 【气相 xTB 的 ΔG 对本规则【符号系统性错误】（水解由溶剂化熵驱动，气相算不出），已在 scorer.assign_thermo 里跳过 —— 不让已知错误的信号影响排序。实测见 tools/refine_hydrolysis_boundary.py】",
      "max_products_per_molecule": 3,
      "thermo_unreliable": true
    },
    {
      "id": "hydrolysis_glycoside_001",
