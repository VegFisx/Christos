      "byproducts": {},
      "condition_profile": "hydrolysis",
      "priority": 0.85,
      "status": "active",
      "notes": "实测差值 O1H2，补 1 分子水即配平。乌头碱减毒主途径。引擎须用 RDChiral：rdkit 原生 RunReactants 在环内断键时会复制原子。",
      "max_products_per_molecule": 3
    },
    {
