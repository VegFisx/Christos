    {
      "id": "hydrolysis_ester_001",
      "name": "酯水解",
      "category": "hydrolysis",
      "smarts": "[C:1](=[O:2])[O:3][C:4]>>[C:1](=[O:2])[O:3][H].[C:4][OH]",
      "reversible": false,
